# Pencil AI Orchestrator Environment Configuration

# Application Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Provider Credentials (50+ Model Matrix)
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...
ADOBE_FIREFLY_API_KEY=...
RUNWAY_API_KEY=...
ELEVENLABS_API_KEY=...

# Vertex AI (preferred over GEMINI_API_KEY if you want usage billed against a
# Google Cloud Billing account / trial credit -- GEMINI_API_KEY above hits the
# AI Studio endpoint, which Google excludes from Cloud trial credit as of
# March 2026). Requires `gcloud auth application-default login` locally, or
# GOOGLE_APPLICATION_CREDENTIALS pointing at a service account key in prod.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Groq (fast Llama/GPT-OSS inference). Multiple keys are round-robined across
# calls to spread rate-limit load; only GROQ_API_KEY_1 is required.
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=gsk_...
GROQ_API_KEY_3=gsk_...

# Meta Business SDK Credentials (Official Marketing API)
META_SYSTEM_USER_TOKEN=EAAG...
META_AD_ACCOUNT_ID=act_1089271629
META_PAGE_ID=108927162983712
META_APP_ID=...
META_APP_SECRET=...

# Persistence & State Checkpoint Database
DATABASE_URL=postgresql://user:password@localhost:5432/pencil_orchestrator
COCKROACHDB_URL=postgresql://user:password@free-tier.gcp-us-central1.cockroachlabs.cloud:26257/pencil_db?sslmode=verify-full
